<%- contentFor('body') %>

    <div
        class="bg-gradient-to-r from-pink-600 to-purple-600 text-white rounded-xl shadow-lg mb-6 overflow-hidden animate-fade-in">
        <div class="relative p-6 md:p-8">
            <div class="absolute right-0 top-0 opacity-10">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-64 h-64">
                    <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z" />
                </svg>
            </div>
            <div class="relative z-10">
                <h1 class="text-3xl md:text-4xl font-bold mb-2">
                    <%= locale.music?.title || "Music Control" %>
                </h1>
                <p class="text-pink-100 mb-4 max-w-2xl">
                    <%= locale.music?.description || "Control your Discord bot's music playback from here" %>
                </p>

                <div class="flex flex-wrap gap-3 mt-2">
                    <div class="flex items-center gap-2 bg-white/20 rounded-full px-4 py-1.5" id="music-status-badge">
                        <div class="h-2.5 w-2.5 rounded-full bg-gray-400" id="status-indicator"></div>
                        <span class="text-sm font-medium" id="status-text">
                            <%= locale.music?.notPlaying || "Not Playing" %>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
        <!-- Now Playing Section -->
        <div class="lg:col-span-2 space-y-6">
            <!-- Now Playing Card -->
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6">
                <h2 class="text-xl font-bold text-gray-800 dark:text-white mb-6 flex items-center gap-2">
                    <i class="fas fa-headphones text-pink-500"></i>
                    <%= locale.music?.nowPlaying || "Now Playing" %>
                </h2>

                <div id="now-playing-container">
                    <!-- Empty State -->
                    <div id="empty-state" class="text-center py-8">
                        <div
                            class="w-24 h-24 mx-auto bg-gray-100 dark:bg-gray-700 rounded-full flex items-center justify-center mb-4">
                            <i class="fas fa-music text-4xl text-gray-400"></i>
                        </div>
                        <p class="text-gray-500 dark:text-gray-400 mb-4">
                            <%= locale.music?.noSongPlaying || "No song is currently playing" %>
                        </p>
                        <p class="text-sm text-gray-400">
                            <%= locale.music?.useSearchToPlay || "Use the search box to play a song" %>
                        </p>
                    </div>

                    <!-- Playing State (hidden by default) -->
                    <div id="playing-state" class="hidden">
                        <div class="flex flex-col md:flex-row gap-6">
                            <div class="flex-shrink-0">
                                <img id="song-thumbnail" src="" alt="Thumbnail"
                                    class="w-32 h-32 object-cover rounded-lg shadow-md">
                            </div>
                            <div class="flex-grow">
                                <h3 id="song-title" class="text-xl font-bold text-gray-800 dark:text-white mb-1"></h3>
                                <p id="song-author" class="text-gray-500 dark:text-gray-400 mb-3"></p>
                                <p id="song-duration" class="text-sm text-gray-400 mb-4"></p>

                                <!-- Progress Bar -->
                                <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2 mb-4">
                                    <div id="progress-bar"
                                        class="bg-pink-500 h-2 rounded-full transition-all duration-300"
                                        style="width: 0%"></div>
                                </div>

                                <!-- Control Buttons -->
                                <div class="flex items-center gap-3">
                                    <button id="btn-prev"
                                        class="w-10 h-10 bg-gray-100 dark:bg-gray-700 rounded-full flex items-center justify-center hover:bg-gray-200 dark:hover:bg-gray-600 transition"
                                        disabled>
                                        <i class="fas fa-step-backward text-gray-600 dark:text-gray-300"></i>
                                    </button>
                                    <button id="btn-play-pause"
                                        class="w-14 h-14 bg-pink-500 rounded-full flex items-center justify-center hover:bg-pink-600 transition shadow-lg">
                                        <i class="fas fa-pause text-white text-xl"></i>
                                    </button>
                                    <button id="btn-next"
                                        class="w-10 h-10 bg-gray-100 dark:bg-gray-700 rounded-full flex items-center justify-center hover:bg-gray-200 dark:hover:bg-gray-600 transition">
                                        <i class="fas fa-step-forward text-gray-600 dark:text-gray-300"></i>
                                    </button>
                                    <button id="btn-stop"
                                        class="w-10 h-10 bg-red-100 dark:bg-red-900/30 rounded-full flex items-center justify-center hover:bg-red-200 dark:hover:bg-red-800/30 transition">
                                        <i class="fas fa-stop text-red-500"></i>
                                    </button>
                                    <button id="btn-loop"
                                        class="w-10 h-10 bg-gray-100 dark:bg-gray-700 rounded-full flex items-center justify-center hover:bg-gray-200 dark:hover:bg-gray-600 transition">
                                        <i class="fas fa-redo text-gray-600 dark:text-gray-300"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Search & Play Section -->
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6">
                <h2 class="text-xl font-bold text-gray-800 dark:text-white mb-4 flex items-center gap-2">
                    <i class="fas fa-search text-purple-500"></i>
                    <%= locale.music?.searchPlay || "Search & Play" %>
                </h2>

                <div class="space-y-4">
                    <!-- Voice Channel Selection -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                            <%= locale.music?.voiceChannel || "Voice Channel" %>
                        </label>
                        <select id="voice-channel-select"
                            class="w-full bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg px-4 py-2 text-gray-800 dark:text-white focus:ring-2 focus:ring-pink-500 focus:border-transparent">
                            <option value="">
                                <%= locale.music?.selectChannel || "Select a voice channel..." %>
                            </option>
                            <% if (voiceChannels && voiceChannels.length> 0) { %>
                                <% voiceChannels.forEach(channel=> { %>
                                    <option value="<%= channel.id %>">
                                        <%= channel.name %> (<%= channel.members %> members)
                                    </option>
                                    <% }); %>
                                        <% } %>
                        </select>
                    </div>

                    <!-- Search Input -->
                    <div class="flex gap-2">
                        <input type="text" id="search-input"
                            class="flex-grow bg-gray-50 dark:bg-gray-700 border border-gray-300 dark:border-gray-600 rounded-lg px-4 py-3 text-gray-800 dark:text-white placeholder-gray-400 focus:ring-2 focus:ring-pink-500 focus:border-transparent"
                            placeholder="<%= locale.music?.searchPlaceholder || 'Enter song name or YouTube URL...' %>">
                        <button id="btn-search-play"
                            class="bg-pink-500 hover:bg-pink-600 text-white px-6 py-3 rounded-lg font-medium transition flex items-center gap-2">
                            <i class="fas fa-play"></i>
                            <%= locale.music?.play || "Play" %>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Queue Section -->
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-xl font-bold text-gray-800 dark:text-white flex items-center gap-2">
                        <i class="fas fa-list text-blue-500"></i>
                        <%= locale.music?.queue || "Queue" %>
                            <span id="queue-count"
                                class="text-sm bg-gray-200 dark:bg-gray-700 px-2 py-0.5 rounded-full">0</span>
                    </h2>
                    <button id="btn-clear-queue" class="text-sm text-red-500 hover:text-red-600 transition">
                        <i class="fas fa-trash mr-1"></i>
                        <%= locale.music?.clearQueue || "Clear" %>
                    </button>
                </div>

                <div id="queue-container">
                    <div id="queue-empty" class="text-center py-6 text-gray-400">
                        <i class="fas fa-inbox text-3xl mb-2"></i>
                        <p>
                            <%= locale.music?.queueEmpty || "Queue is empty" %>
                        </p>
                    </div>
                    <div id="queue-list" class="space-y-2 hidden max-h-64 overflow-y-auto">
                        <!-- Queue items will be inserted here -->
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
            <!-- Volume Control -->
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6">
                <h2 class="text-xl font-bold text-gray-800 dark:text-white mb-4 flex items-center gap-2">
                    <i class="fas fa-volume-up text-green-500"></i>
                    <%= locale.music?.volume || "Volume" %>
                </h2>

                <div class="flex items-center gap-4">
                    <i class="fas fa-volume-down text-gray-400"></i>
                    <input type="range" id="volume-slider" min="0" max="100" value="100"
                        class="flex-grow h-2 bg-gray-200 dark:bg-gray-700 rounded-lg appearance-none cursor-pointer accent-pink-500">
                    <i class="fas fa-volume-up text-gray-400"></i>
                </div>
                <div class="text-center mt-2">
                    <span id="volume-value" class="text-2xl font-bold text-gray-800 dark:text-white">100</span>
                    <span class="text-gray-400">%</span>
                </div>
            </div>

            <!-- Quick Stats -->
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6">
                <h2 class="text-xl font-bold text-gray-800 dark:text-white mb-4">
                    <%= locale.music?.stats || "Stats" %>
                </h2>

                <div class="space-y-4">
                    <div class="flex justify-between items-center">
                        <span class="text-gray-600 dark:text-gray-400">
                            <%= locale.music?.songsInQueue || "Songs in Queue" %>
                        </span>
                        <span id="stat-queue" class="font-bold text-gray-800 dark:text-white">0</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-gray-600 dark:text-gray-400">
                            <%= locale.music?.loopStatus || "Loop" %>
                        </span>
                        <span id="stat-loop" class="font-bold text-gray-800 dark:text-white">
                            <%= locale.music?.off || "Off" %>
                        </span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-gray-600 dark:text-gray-400">
                            <%= locale.music?.statusLabel || "Status" %>
                        </span>
                        <span id="stat-status" class="font-bold text-green-500">
                            <%= locale.music?.ready || "Ready" %>
                        </span>
                    </div>
                </div>
            </div>

            <!-- Help -->
            <div class="bg-gradient-to-br from-purple-500 to-pink-500 rounded-xl shadow-md p-6 text-white">
                <h2 class="text-xl font-bold mb-3 flex items-center gap-2">
                    <i class="fas fa-info-circle"></i>
                    <%= locale.music?.tips || "Tips" %>
                </h2>
                <ul class="space-y-2 text-sm text-purple-100">
                    <li class="flex items-start gap-2">
                        <i class="fas fa-check mt-1"></i>
                        <span>
                            <%= locale.music?.tip1 || "Search by song name or paste YouTube URL" %>
                        </span>
                    </li>
                    <li class="flex items-start gap-2">
                        <i class="fas fa-check mt-1"></i>
                        <span>
                            <%= locale.music?.tip2 || "Add multiple songs to create a queue" %>
                        </span>
                    </li>
                    <li class="flex items-start gap-2">
                        <i class="fas fa-check mt-1"></i>
                        <span>
                            <%= locale.music?.tip3 || "Use loop to repeat the current song" %>
                        </span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <%- contentFor('scripts') %>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                console.log('Music page loaded');

                const searchInput = document.getElementById('search-input');
                const btnSearchPlay = document.getElementById('btn-search-play');
                const voiceChannelSelect = document.getElementById('voice-channel-select');
                const btnPlayPause = document.getElementById('btn-play-pause');
                const btnNext = document.getElementById('btn-next');
                const btnStop = document.getElementById('btn-stop');
                const btnLoop = document.getElementById('btn-loop');
                const btnClearQueue = document.getElementById('btn-clear-queue');
                const volumeSlider = document.getElementById('volume-slider');
                const volumeValue = document.getElementById('volume-value');

                let currentStatus = { isPlaying: false, isPaused: false, isLoop: false };

                // Load saved voice channel from localStorage
                const savedChannel = localStorage.getItem('selectedVoiceChannel');
                if (savedChannel && voiceChannelSelect) {
                    voiceChannelSelect.value = savedChannel;
                    console.log('Loaded saved channel:', savedChannel);
                }

                // Save voice channel selection to localStorage
                if (voiceChannelSelect) {
                    voiceChannelSelect.addEventListener('change', function () {
                        localStorage.setItem('selectedVoiceChannel', this.value);
                        console.log('Saved channel:', this.value);
                    });
                }

                console.log('Voice channels available:', voiceChannelSelect ? voiceChannelSelect.options.length - 1 : 0);

                // Update UI based on status
                function updateUI(status) {
                    currentStatus = status;

                    const emptyState = document.getElementById('empty-state');
                    const playingState = document.getElementById('playing-state');
                    const statusIndicator = document.getElementById('status-indicator');
                    const statusText = document.getElementById('status-text');

                    if (status.currentSong) {
                        emptyState.classList.add('hidden');
                        playingState.classList.remove('hidden');

                        document.getElementById('song-thumbnail').src = status.currentSong.thumbnail || '';
                        document.getElementById('song-title').textContent = status.currentSong.title;
                        document.getElementById('song-author').textContent = status.currentSong.author || '';
                        document.getElementById('song-duration').textContent = formatDuration(status.currentSong.duration);

                        statusIndicator.classList.remove('bg-gray-400');
                        statusIndicator.classList.add(status.isPaused ? 'bg-yellow-400' : 'bg-green-400');
                        statusText.textContent = status.isPaused ? 'Paused' : 'Playing';

                        // Update play/pause button
                        const icon = btnPlayPause.querySelector('i');
                        icon.classList.remove('fa-play', 'fa-pause');
                        icon.classList.add(status.isPaused ? 'fa-play' : 'fa-pause');
                    } else {
                        emptyState.classList.remove('hidden');
                        playingState.classList.add('hidden');
                        statusIndicator.classList.remove('bg-green-400', 'bg-yellow-400');
                        statusIndicator.classList.add('bg-gray-400');
                        statusText.textContent = 'Not Playing';
                    }

                    // Update loop button
                    if (status.isLoop) {
                        btnLoop.classList.add('bg-pink-500', 'text-white');
                        btnLoop.classList.remove('bg-gray-100', 'dark:bg-gray-700');
                    } else {
                        btnLoop.classList.remove('bg-pink-500', 'text-white');
                        btnLoop.classList.add('bg-gray-100', 'dark:bg-gray-700');
                    }

                    // Update queue
                    updateQueue(status.queue || []);

                    // Update stats
                    document.getElementById('stat-queue').textContent = (status.queue || []).length;
                    document.getElementById('stat-loop').textContent = status.isLoop ? 'On' : 'Off';
                    document.getElementById('stat-status').textContent = status.isPlaying ? 'Playing' : 'Ready';

                    // Update volume
                    volumeSlider.value = status.volume || 100;
                    volumeValue.textContent = status.volume || 100;
                }

                // Update queue display
                function updateQueue(queue) {
                    const queueEmpty = document.getElementById('queue-empty');
                    const queueList = document.getElementById('queue-list');
                    const queueCount = document.getElementById('queue-count');

                    queueCount.textContent = queue.length;

                    if (queue.length === 0) {
                        queueEmpty.classList.remove('hidden');
                        queueList.classList.add('hidden');
                        return;
                    }

                    queueEmpty.classList.add('hidden');
                    queueList.classList.remove('hidden');

                    queueList.innerHTML = queue.map((song, index) => `
      <div class="flex items-center gap-3 p-2 bg-gray-50 dark:bg-gray-700 rounded-lg">
        <span class="text-gray-400 text-sm w-6 text-center">${index + 1}</span>
        <img src="${song.thumbnail || ''}" class="w-10 h-10 rounded object-cover">
        <div class="flex-grow min-w-0">
          <p class="text-sm font-medium text-gray-800 dark:text-white truncate">${song.title}</p>
          <p class="text-xs text-gray-400">${formatDuration(song.duration)}</p>
        </div>
        <button onclick="removeFromQueue(${index})" class="text-red-400 hover:text-red-500">
          <i class="fas fa-times"></i>
        </button>
      </div>
    `).join('');
                }

                // Format duration helper
                function formatDuration(seconds) {
                    if (!seconds) return '0:00';
                    const mins = Math.floor(seconds / 60);
                    const secs = seconds % 60;
                    return `${mins}:${String(secs).padStart(2, '0')}`;
                }

                // Fetch current status
                async function fetchStatus() {
                    try {
                        const response = await fetch('/api/music/status');
                        if (response.ok) {
                            const status = await response.json();
                            updateUI(status);
                        }
                    } catch (error) {
                        console.error('Failed to fetch status:', error);
                    }
                }

                // Play song
                async function playSong() {
                    console.log('playSong called');
                    const query = searchInput.value.trim();
                    const channelId = voiceChannelSelect.value;
                    console.log('Query:', query, 'Channel:', channelId);

                    if (!query) {
                        showToast('Please enter a song name or URL', 'error');
                        return;
                    }

                    if (!channelId) {
                        showToast('Please select a voice channel', 'error');
                        return;
                    }

                    btnSearchPlay.disabled = true;
                    btnSearchPlay.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Loading...';

                    try {
                        console.log('Sending play request...');
                        const response = await fetch('/api/music/play', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ query, channelId })
                        });

                        console.log('Response status:', response.status);
                        const data = await response.json();
                        console.log('Response data:', data);

                        if (response.ok) {
                            if (data.queued) {
                                showToast(`Added to queue: ${data.song.title}`, 'success');
                            } else {
                                showToast(`Now playing: ${data.song.title}`, 'success');
                            }
                            searchInput.value = '';
                            fetchStatus();
                        } else {
                            console.error('Play error:', data.error);
                            showToast(data.error || 'Failed to play', 'error');
                        }
                    } catch (error) {
                        console.error('Fetch error:', error);
                        showToast('Failed to play song', 'error');
                    } finally {
                        btnSearchPlay.disabled = false;
                        btnSearchPlay.innerHTML = '<i class="fas fa-play"></i> Play';
                    }
                }

                // Control functions
                async function musicControl(action, data = {}) {
                    try {
                        const response = await fetch(`/api/music/${action}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(data)
                        });

                        if (response.ok) {
                            fetchStatus();
                            return true;
                        }
                        return false;
                    } catch (error) {
                        console.error(`${action} failed:`, error);
                        return false;
                    }
                }

                // Remove from queue
                window.removeFromQueue = async function (index) {
                    await musicControl('queue/remove', { index });
                };

                // Toast notification
                function showToast(message, type = 'info') {
                    const toast = document.createElement('div');
                    toast.className = `fixed bottom-4 right-4 px-6 py-3 rounded-lg shadow-lg text-white z-50 animate-fade-in ${type === 'error' ? 'bg-red-500' : type === 'success' ? 'bg-green-500' : 'bg-blue-500'
                        }`;
                    toast.textContent = message;
                    document.body.appendChild(toast);
                    setTimeout(() => toast.remove(), 3000);
                }

                // Event listeners
                btnSearchPlay.addEventListener('click', playSong);
                searchInput.addEventListener('keypress', (e) => {
                    if (e.key === 'Enter') playSong();
                });

                btnPlayPause.addEventListener('click', () => {
                    musicControl(currentStatus.isPaused ? 'resume' : 'pause');
                });

                btnNext.addEventListener('click', () => musicControl('skip'));
                btnStop.addEventListener('click', () => musicControl('stop'));
                btnLoop.addEventListener('click', () => musicControl('loop'));
                btnClearQueue.addEventListener('click', () => musicControl('queue/clear'));

                volumeSlider.addEventListener('input', (e) => {
                    volumeValue.textContent = e.target.value;
                });

                volumeSlider.addEventListener('change', (e) => {
                    musicControl('volume', { volume: parseInt(e.target.value) });
                });

                // Initial fetch and polling
                fetchStatus();
                setInterval(fetchStatus, 5000);
            });
        </script>
